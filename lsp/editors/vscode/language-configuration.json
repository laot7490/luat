{
	"comments": { "lineComment": "--", "blockComment": ["--[[", "]]" ] },
	"brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "'", "close": "'", "notIn": ["string", "comment"] },
		{ "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
		{ "open": "`", "close": "`", "notIn": ["string", "comment"] }
	],
	"indentationRules": {
		"increaseIndentPattern": "^\\s*(function|if|for|while|repeat|do|type\\s+.*=\\s*\\{).*|\\{[^}]*$",
		"decreaseIndentPattern": "^\\s*(end|until|\\}).*$"
	}
}
