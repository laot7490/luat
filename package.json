{
	"name": "luat-workspace",
	"private": true,
	"scripts": {
		"local": "cargo install --path . --force",
		"lsp:build": "node scripts/build-lsp.mjs",
		"prepare:major": "node scripts/prepare-version.mjs major",
		"prepare:minor": "node scripts/prepare-version.mjs minor",
		"prepare:patch": "node scripts/prepare-version.mjs patch",
		"sync:versions": "node scripts/sync-versions.mjs",
		"sync:versions:cli": "node scripts/sync-versions.mjs cli",
		"sync:versions:lsp": "node scripts/sync-versions.mjs lsp",
		"prepare:cli:major": "node scripts/prepare-version.mjs major cli",
