		"prepare:cli:patch": "node scripts/prepare-version.mjs patch cli",
		"prepare:lsp:major": "node scripts/prepare-version.mjs major lsp",
		"prepare:lsp:minor": "node scripts/prepare-version.mjs minor lsp",
