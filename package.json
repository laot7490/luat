{
	"name": "luat-workspace",
	"private": true,
	"scripts": {
		"check": "cargo test --workspace --locked && cargo clippy --workspace --all-targets --locked -- -D warnings",
		"test": "npm run check",
		"fmt": "cargo fmt --all --check",
		"cli:install": "cargo install --path . --force",
		"cli:build": "cargo build -p luat",
		"lsp:build": "node scripts/build-lsp.mjs",
		"version:sync": "node scripts/sync-versions.mjs",
		"version:prepare": "node scripts/prepare-version.mjs"
	}
}
